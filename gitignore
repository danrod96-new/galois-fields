# galois_fields - files generated by builder.sce, test_run and the editor/OS.
# Everything listed here is recreated by `exec builder.sce` and removed by
# `exec cleaner.sce`.

# --- Top-level loader/unloader/cleaner (tbx_build_loader / tbx_build_cleaner)
/loader.sce
/unloader.sce
/cleaner.sce

# --- Compiled macros (tbx_builder_macros / genlib)
/macros/*.bin
/macros/lib
/macros/names

# --- C library (tbx_build_src)
/src/cleaner_src.sce
/src/c/loader.sce
/src/c/cleaner.sce
/src/c/Makelib*
/src/c/libgalois_fields.*
!/src/c/galois_fields.c
!/src/c/galois_fields.h

# --- Gateways (tbx_build_gateway)
/sci_gateway/loader_gateway.sce
/sci_gateway/cleaner_gateway.sce
/sci_gateway/c/loader.sce
/sci_gateway/c/cleaner.sce
/sci_gateway/c/Makelib*
/sci_gateway/c/gateway_galois_fields.*
/sci_gateway/c/libgateway_galois_fields*

# --- Help (tbx_builder_help, needs Scilab with Java)
/jar/
/help/*/master_help.xml
/help/*/scilab_*_help/

# --- Object files and shared libraries on any platform
*.o
*.obj
*.so
*.dll
*.dylib
*.lib
*.exp
*.pdb
*.ilk
*.def

# --- Tests (test_run)
/tests/**/*.dia
/tests/**/*.dia.tmp

# --- Release archives
*.zip
*.tar.gz

# --- Editor and OS files
*~
*.swp
.DS_Store
Thumbs.db
.vscode/
.idea/
