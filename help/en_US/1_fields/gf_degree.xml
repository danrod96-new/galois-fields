<refentry xmlns="http://docbook.org/ns/docbook" xmlns:xlink="http://www.w3.org/1999/xlink" xmlns:svg="http://www.w3.org/2000/svg" xmlns:ns3="http://www.w3.org/1999/xhtml" xmlns:mml="http://www.w3.org/1998/Math/MathML" xmlns:db="http://docbook.org/ns/docbook" version="5.0-subset Scilab" xml:id="gf_degree" xml:lang="en">

    <refnamediv>
        <refname>gf_degree</refname>
        <refpurpose>Degree of a finite field over its prime subfield</refpurpose>
    </refnamediv>
    <refsynopsisdiv>
        <title>Syntax</title>
        <synopsis>n = gf_degree(F)</synopsis>
    </refsynopsisdiv>
    <refsection>
        <title>Arguments</title>
        <variablelist>
            <varlistentry>
                <term>F</term>
                <listitem>
                    <para>A field created by <link linkend="gf_create_field">gf_create_field</link>.</para>
                </listitem>
            </varlistentry>
            <varlistentry>
                <term>n</term>
                <listitem>
                    <para>The degree n of GF(p^n) over GF(p). It is also the degree of the field's primitive polynomial and the number of coefficients of each element.</para>
                </listitem>
            </varlistentry>
        </variablelist>
    </refsection>
    <refsection>
        <title>Description</title>
        <para><literal>gf_degree(F)</literal> returns n for the field GF(p^n).</para>
    </refsection>
    <refsection>
        <title>Examples</title>
        <programlisting role="example"><![CDATA[
F = gf_create_field(3, 2);
gf_degree(F)   // 2
]]></programlisting>
    </refsection>
    <refsection role="see also">
        <title>See also</title>
        <simplelist type="inline">
            <member><link linkend="gf_characteristic">gf_characteristic</link></member>
            <member><link linkend="gf_order">gf_order</link></member>
        </simplelist>
    </refsection>
